NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=
# Sans slash final, ex. https://trouve-ta-formation.fr
NEXT_PUBLIC_SITE_URL=
# Espace organisme (sous-domaine), sans slash final. Production par défaut ; dev : https://partenaires-dev.trouve-ta-formation.fr,
# local : http://partenaires.localhost:3000
NEXT_PUBLIC_URL_ESPACE_ORGANISME=
# Scripts d'administration (creer-admin, config-auth-supabase) : jeton personnel Supabase, jamais sur Vercel
SUPABASE_ACCESS_TOKEN=
# Compte organisme de test (scripts/compte-test.mjs, Playwright)
E2E_ORGANISME_EMAIL=
E2E_ORGANISME_MOT_DE_PASSE=
# Resend (envoi d'emails) : clé « Sending access » limitée au domaine
RESEND_SENDING_KEY=
# Cloudflare Turnstile (inscription organisme, mode invisible). En local, clés de test Cloudflare :
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB  TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Deploy hook Vercel de la branche (Settings → Git → Deploy Hooks) : relance un build à l'archivage d'un titre pour
# générer sa redirection 301. Posé pour dev ; à créer pour la production au lancement de l'admin.
VERCEL_DEPLOY_HOOK_URL=
# Outils tiers soumis au consentement (bandeau cookies). Vides = outil désactivé, et sans aucun outil le bandeau
# n'apparaît pas. GA4 : G-XXXXXXX · Google Ads : AW-XXXXXXX · Meta : identifiant numérique du pixel.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# 1 = affiche le bandeau sans identifiant, pour le relire (dev/preprod uniquement, rien n'est chargé)
NEXT_PUBLIC_BANDEAU_APERCU=
